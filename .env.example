# Copy to .env and adjust as needed. Never commit .env.
# All values are placeholders; libpq standard variables are honored.

# Connection settings for both the Python ingestion and dbt.
# Options that work out of the box in this environment:
#   PGHOST=/var/run/postgresql   (local socket, peer auth, no password needed)
# or a TCP host with password:
#   PGHOST=localhost PGUSER=postgres PGPASSWORD=changeit
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=changeit
PGDATABASE=olist_analytics

# Where the raw Olist CSVs live (relative paths resolved from the repo root)
DATA_DIR=data
